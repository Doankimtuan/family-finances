{
  "name": "family-finances",
  "version": "2.0.0-rewrite",
  "private": true,
  "description": "ViNha rewrite workspace — Architecture v2.0.0 skeleton (legacy retired to archive/legacy-v1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test tests/e2e/v1-critical-flow.release.spec.ts --workers=1",
    "ownership:test-harness": "node scripts/ownership-test-harness.mjs",
    "test:e2e:smoke": "playwright test tests/e2e/auth-entry.smoke.spec.ts tests/e2e/health-insights.smoke.spec.ts tests/e2e/home-dashboard.smoke.spec.ts",
    "test:constitution": "vitest run tests/unit/health-readonly-shield.test.ts tests/unit/ai-policy.test.ts tests/unit/health-insights.test.ts tests/unit/health-pulse.test.ts tests/unit/get-health-detail.integration.test.ts tests/unit/health-insights-policy-block.test.ts tests/unit/log-health-ai-policy-block.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@internationalized/date": "^3.12.3",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.109.0",
    "@tanstack/react-query": "^5.90.21",
    "geist": "^1.3.1",
    "lodash-es": "^4.18.1",
    "motion": "^12.0.0",
    "next": "16.3.1",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-aria": "3.51.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "tailwind-variants": "^1.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-unused-imports": "^4.1.0",
    "husky": "^9.1.0",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.4.0",
    "playwright": "^1.50.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
