{
  "version": "v1.0.0",
  "foundation": "v1.1.0",
  "color": {
    "color-canvas-outer": {
      "light": "stone-100",
      "dark": "zinc-950",
      "role": "desktop decorative canvas"
    },
    "color-canvas": {
      "light": "stone-50",
      "dark": "zinc-950",
      "role": "viewport background"
    },
    "color-surface": {
      "light": "white",
      "dark": "zinc-900",
      "role": "panels"
    },
    "color-surface-elevated": {
      "light": "white",
      "dark": "zinc-800",
      "role": "sheets/dialogs"
    },
    "color-border-subtle": {
      "light": "stone-200",
      "dark": "zinc-700",
      "role": "dividers"
    },
    "color-border-strong": {
      "light": "stone-300",
      "dark": "zinc-600",
      "role": "emphasized borders"
    },
    "color-text-primary": {
      "light": "zinc-900",
      "dark": "zinc-50",
      "role": "body/titles"
    },
    "color-text-secondary": {
      "light": "zinc-600",
      "dark": "zinc-400",
      "role": "supporting"
    },
    "color-text-muted": {
      "light": "zinc-500",
      "dark": "zinc-500",
      "role": "meta"
    },
    "color-accent": {
      "light": "#0F766E",
      "dark": "teal-400",
      "role": "brand CTA/active"
    },
    "color-accent-fg": {
      "light": "off-white",
      "dark": "zinc-950",
      "role": "on accent"
    },
    "color-danger": {
      "light": "rose-700",
      "dark": "rose-400",
      "role": "destructive"
    },
    "color-warning": {
      "light": "amber-700",
      "dark": "amber-400",
      "role": "warn overspend"
    },
    "color-success": {
      "light": "emerald-700",
      "dark": "emerald-400",
      "role": "success"
    },
    "color-credit": {
      "light": "emerald-700",
      "dark": "emerald-400",
      "role": "money in"
    },
    "color-debit": {
      "light": "zinc-800",
      "dark": "zinc-200",
      "role": "money out emphasis"
    },
    "color-focus-ring": {
      "light": "accent",
      "dark": "accent",
      "role": "focus"
    }
  },
  "viewport": {
    "app-viewport-max": "440px",
    "app-viewport-min": "320px",
    "app-viewport-band-max": "480px",
    "app-viewport-tablet-optional": "640px"
  },
  "spacing": {
    "space-0": 0,
    "space-1": 4,
    "space-2": 8,
    "space-3": 12,
    "space-4": 16,
    "space-5": 20,
    "space-6": 24,
    "space-8": 32,
    "space-10": 40,
    "space-12": 48,
    "space-16": 64
  },
  "radius": {
    "radius-sm": 6,
    "radius-md": 10,
    "radius-lg": 12,
    "radius-xl": 16,
    "radius-full": 9999
  },
  "elevation": {
    "elevation-0": "border-only",
    "elevation-1": "sticky",
    "elevation-2": "popover",
    "elevation-3": "modal-sheet"
  },
  "typography": {
    "font-sans": "Geist",
    "font-mono": "Geist Mono / ui-monospace",
    "text-xs": 12,
    "text-sm": 14,
    "text-base": 16,
    "text-lg": 18,
    "text-xl": 20,
    "text-2xl": 24,
    "text-3xl": 30,
    "font-normal": 400,
    "font-medium": 500,
    "font-semibold": 600,
    "money": "tabular-nums"
  },
  "motion": {
    "duration-fast": "150ms",
    "duration-normal": "200ms",
    "duration-slow": "250ms",
    "duration-celebrate": "600ms",
    "ease-standard": "cubic-bezier(0.16, 1, 0.3, 1)"
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "2xl": 1536
  },
  "zIndex": {
    "z-base": 0,
    "z-sticky": 10,
    "z-nav": 20,
    "z-dropdown": 30,
    "z-overlay": 40,
    "z-modal": 50,
    "z-toast": 60
  },
  "opacity": {
    "opacity-disabled": 0.5,
    "opacity-muted": 0.7,
    "opacity-overlay": 0.4,
    "opacity-full": 1
  },
  "icon": {
    "family": "Phosphor",
    "stroke": 1.5,
    "sizes": {
      "sm": 16,
      "md": 20,
      "lg": 24,
      "nav": 24
    }
  },
  "border": {
    "border-width-hairline": "1px",
    "border-width-focus": "2px"
  },
  "shadow": {
    "shadow-1": "tinted sticky",
    "shadow-2": "tinted popover",
    "shadow-3": "tinted modal"
  },
  "chart": {
    "chart-ink": "minimal",
    "chart-series-real": "accent",
    "chart-series-intention": "secondary",
    "chart-grid": "border-subtle"
  }
}
