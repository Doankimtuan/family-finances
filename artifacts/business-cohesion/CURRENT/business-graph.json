{
  "meta": {
    "board": "Business Cohesion & Money Lifecycle Board",
    "date": "2026-08-03",
    "product": "ViNha Household Money Operating System",
    "scope": "Specification v1 + R1 Approved Features",
    "version": "1.0"
  },
  "domains": [
    {
      "id": "accounts",
      "name": "Accounts",
      "context": "Real Ledger",
      "description": "Containers of real money. Ownership principle.",
      "responsibilities": ["Store real money balances", "Own account metadata", "One active account per household member"]
    },
    {
      "id": "transactions",
      "name": "Transactions",
      "context": "Real Ledger",
      "description": "Atoms of financial truth. Cash Flow principle.",
      "responsibilities": ["Record all money movements", "Link transfers", "Support splits (EO-20)", "Support corrections (reversals never deletes)"]
    },
    {
      "id": "cards",
      "name": "Cards",
      "context": "Real Ledger",
      "description": "Payment instruments with credit. Liquidity principle.",
      "responsibilities": ["Track credit limits and balances", "Billing cycles", "APR data (EO-02)", "Interest cost display (EO-13, BR-22)", "Payment reminders (BR-17)"]
    },
    {
      "id": "savings",
      "name": "Savings",
      "context": "Real Ledger",
      "description": "Real financial products with terms/maturity. Wealth Building principle.",
      "responsibilities": ["Manage savings products", "Track maturity dates", "Maturity alerts (EO-12, BR-21)", "Maturity decisions → Inbox (BR-10)"]
    },
    {
      "id": "installments",
      "name": "Installments",
      "context": "Real Ledger",
      "description": "Structured debt repayment. Debt principle.",
      "responsibilities": ["Define installment plans", "Track payment schedules", "Interest visibility (EO-09, BR-20)", "Completion detection (BR-11)"]
    },
    {
      "id": "jars",
      "name": "Budgets/Jars",
      "context": "Intention Plan",
      "description": "Intention envelopes. Planning/Commitment principle.",
      "responsibilities": ["Define jar allocations", "Track spending against jars", "Enforce overspend policy (BR-07)", "Support reallocation (EO-19)", "Template application (EO-06, BR-19)"]
    },
    {
      "id": "goals",
      "name": "Goals",
      "context": "Intention Plan",
      "description": "Aspirational targets. Commitment/Forecasting principle.",
      "responsibilities": ["Define goal targets and timelines", "Link to jars for funding", "Track progress", "Milestone celebration (EO-18)"]
    },
    {
      "id": "planning",
      "name": "Planning/RecurringPatterns",
      "context": "Intention Plan",
      "description": "Automation rules simplified to RecurringPatterns (EO-04).",
      "responsibilities": ["Define recurring patterns", "Auto-generate transactions on schedule", "Populate calendar (EO-03)", "Auto-allocate income per BR-04"]
    },
    {
      "id": "ritual",
      "name": "MonthRitual",
      "context": "Intention Plan",
      "description": "Period close ceremony. Discipline principle.",
      "responsibilities": ["Preview month summary", "Assisted review (BR-09)", "Quick Close (EO-10, BR-23/24)", "Lock plan on approval (BR-08)", "Store snapshots"]
    },
    {
      "id": "inbox",
      "name": "Inbox",
      "context": "Intention Plan",
      "description": "Decision queue bridging Real and Intention.",
      "responsibilities": ["Receive unmapped expenses (BR-05)", "Receive maturity decisions (BR-10)", "Receive payment reminders (BR-17)", "Batch operations (EO-07)", "Auto-resolution (R2: EO-16)"]
    },
    {
      "id": "tenancy",
      "name": "Tenancy",
      "context": "Together",
      "description": "Household collaboration. Collaboration/Transparency/Trust principle.",
      "responsibilities": ["Manage household membership", "Enforce auth (BR-02)", "RLS enforcement (BR-02a)", "Single account per email (BR-02b)", "One active household (BR-12)", "Policy change visibility (BR-13)"]
    },
    {
      "id": "health",
      "name": "Health",
      "context": "Insight",
      "description": "Read-only financial mirror. Reflection principle.",
      "responsibilities": [
        "Read-only summarization (Health-RO constitutional invariant)",
        "Score calculation (EO-08)",
        "Narrative generation",
        "Trend analysis",
        "Light scenario exploration",
        "Must not invent balances or move money (Product BR-14 AI non-invention also applies)"
      ]
    },
    {
      "id": "categories",
      "name": "Categories",
      "context": "Shared",
      "description": "Classification tags shared by Real and Intention.",
      "responsibilities": ["Categorize transactions", "Auto-categorization rules (EO-01)", "Override tracking (BR-16)", "Jar mapping bridge"]
    }
  ],
  "features": [
    {"id": "EO-01", "name": "Auto-Categorization", "domain": "categories", "priority": "P1", "dependencies": []},
    {"id": "EO-02", "name": "Card Payment Due Dates + APR", "domain": "cards", "priority": "P1", "dependencies": []},
    {"id": "EO-03", "name": "Recurring Bill Calendar", "domain": "planning", "priority": "P1", "dependencies": ["EO-04"]},
    {"id": "EO-04", "name": "Simplify Planning to RecurringPatterns", "domain": "planning", "priority": "P0", "dependencies": []},
    {"id": "EO-05", "name": "Transaction Search/Filtering", "domain": "transactions", "priority": "P1", "dependencies": []},
    {"id": "EO-06", "name": "Jar Templates for Onboarding", "domain": "jars", "priority": "P1", "dependencies": []},
    {"id": "EO-07", "name": "Inbox Batch Operations", "domain": "inbox", "priority": "P1", "dependencies": []},
    {"id": "EO-08", "name": "Health Score Iteration", "domain": "health", "priority": "P2", "dependencies": []},
    {"id": "EO-09", "name": "Installment Interest Visibility", "domain": "installments", "priority": "P1", "dependencies": []},
    {"id": "EO-10", "name": "Month Ritual Quick Close", "domain": "ritual", "priority": "P2", "dependencies": []},
    {"id": "EO-11", "name": "Data Export CSV", "domain": "shared", "priority": "P2", "dependencies": []},
    {"id": "EO-12", "name": "Savings Maturity Alerts", "domain": "savings", "priority": "P1", "dependencies": []},
    {"id": "EO-13", "name": "Card Interest Cost Display", "domain": "cards", "priority": "P1", "dependencies": ["EO-02"]},
    {"id": "EO-18", "name": "Goal Progress Celebration", "domain": "goals", "priority": "P2", "dependencies": []},
    {"id": "EO-19", "name": "Simple Jar Reallocation UX", "domain": "jars", "priority": "P2", "dependencies": []},
    {"id": "EO-20", "name": "Transaction Split Support", "domain": "transactions", "priority": "P1", "dependencies": []}
  ],
  "businessRules": [
    {"id": "BR-01", "rule": "Real ledger ≠ virtual jars", "domain": "global"},
    {"id": "BR-02", "rule": "Auth + membership required for money actions", "domain": "tenancy"},
    {"id": "BR-02a", "rule": "RLS membership enforcement", "domain": "tenancy"},
    {"id": "BR-02b", "rule": "Single account per verified email", "domain": "tenancy"},
    {"id": "BR-03", "rule": "Allocations target only Active jars", "domain": "jars"},
    {"id": "BR-04", "rule": "Income placement: Off|Suggest|Auto; default Suggest; household-level (relocated from Planning)", "domain": "tenancy"},
    {"id": "BR-05", "rule": "Unmapped expenses → Inbox ReviewItems", "domain": "inbox"},
    {"id": "BR-06", "rule": "Movement magnitudes positive with explicit direction", "domain": "jars"},
    {"id": "BR-07", "rule": "Overspend policy: Warn|Block|Allow negative; default Warn", "domain": "jars"},
    {"id": "BR-08", "rule": "Approved Month Ritual locks plan movements", "domain": "ritual"},
    {"id": "BR-09", "rule": "Month Ritual defaults to Assisted", "domain": "ritual"},
    {"id": "BR-10", "rule": "Savings maturity → Inbox-guided flows", "domain": "savings"},
    {"id": "BR-11", "rule": "Installment completes when paid >= num installments", "domain": "installments"},
    {"id": "BR-12", "rule": "One active household per user (v2 Now)", "domain": "tenancy"},
    {"id": "BR-13", "rule": "Material policy changes partner-visible", "domain": "tenancy"},
    {"id": "BR-14", "rule": "AI explains/suggests; never invents balances or moves money without explicit path (Product SoT)", "domain": "global", "note": "ID collision: Philosophy/Decision Board often use BR-14 for Health-RO"},
    {"id": "Health-RO", "rule": "Health is read-only — never mutates money, plans, or decisions (Constitutional / Philosophy)", "domain": "health", "note": "Enforced by this board as distinct from Product BR-14 until SoT splits IDs"},
    {"id": "BR-15", "rule": "Online-only money mutations", "domain": "global"},
    {"id": "BR-16", "rule": "Auto-categorization override (3 overrides → update)", "domain": "categories"},
    {"id": "BR-17", "rule": "Card payment reminder (3 days before due)", "domain": "cards"},
    {"id": "BR-18", "rule": "Minimum payment visibility", "domain": "cards"},
    {"id": "BR-19", "rule": "Template application (Active jars, non-destructive)", "domain": "jars"},
    {"id": "BR-20", "rule": "Interest transparency for installments", "domain": "installments"},
    {"id": "BR-21", "rule": "Savings maturity notification cascade", "domain": "savings"},
    {"id": "BR-22", "rule": "Card carried-balance interest cost display", "domain": "cards"},
    {"id": "BR-23", "rule": "Quick Close eligibility (6 rituals minimum)", "domain": "ritual"},
    {"id": "BR-24", "rule": "Quick Close mandatory summary", "domain": "ritual"},
    {"id": "BR-25", "rule": "Auto-resolution undoable 30 days", "domain": "inbox", "effective": "R2"},
    {"id": "BR-26", "rule": "Auto-resolution permanent partner-visible audit log", "domain": "inbox", "effective": "R2"},
    {"id": "BR-27", "rule": "Max 5 active auto-resolution rules per household", "domain": "inbox", "effective": "R2"}
  ],
