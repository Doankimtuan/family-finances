# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/output/
/screenshots/
/output/playwright/.auth/
/output/playwright/auth-debug/
/output/playwright/together-20a-credentials.json
/.playwright-cli/
/.playwright-mcp/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production.example

# Local CommandCode permissions may contain developer-only commands or env references.
.commandcode/settings.local.json

# Supabase CLI local link/cache (project-ref, pooler URL, service versions)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# reproducible agent/browser evidence
.agents/tmp-*.png
.agents/reports/evidence-*/

# Legacy retirement backups (large tarballs may be kept locally)
# archive/backups/*.tar.gz
