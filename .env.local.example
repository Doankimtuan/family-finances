NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — required for privileged server operations (never expose to the client)
# Prefer the modern Supabase secret key.
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy fallback:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deterministic authenticated V1 release smoke (dedicated test users only)
# The harness creates and removes the exact controlled household fixture.
OWNERSHIP_TEST_A_EMAIL=ownership-test-a@example.com
OWNERSHIP_TEST_A_PASSWORD=replace-with-dedicated-test-password-a
OWNERSHIP_TEST_B_EMAIL=ownership-test-b@example.com
OWNERSHIP_TEST_B_PASSWORD=replace-with-dedicated-test-password-b
# Server-only manual MARKET 02 catalog sync endpoint.
# MARKET_CATALOG_SYNC_SECRET=set-a-long-random-secret
# MARKET_PRICE_SYNC_SECRET=set-a-different-long-random-secret

# Optional — scheduled AI insight system (Supabase Edge Function; not Sprint 0 UI)
# GEMINI_API_KEY=your-gemini-api-key
# AI_WORKER_SECRET=set-a-long-random-secret
# GEMINI_MODEL=gemini-2.5-flash
