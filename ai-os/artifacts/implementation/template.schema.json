{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/specification-engineering/implementation.template.schema.json",
  "title": "Specification engineering implementation human-mirror template",
  "description": "Human mirror for artifacts/implementation/ (implementation-plan).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "summary", "required_kinds", "created_at"],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "kind": { "const": "implementation" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "required_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["build-order", "critical-path", "parallel-work", "blocked", "graph-node", "graph-edge"]
      }
    },
    "raci_note": {
      "type": "string",
      "const": "Owns build-order, critical-path, parallel-work, blocked, graph"
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
