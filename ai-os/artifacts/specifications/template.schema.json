{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/specification-engineering/specifications.template.schema.json",
  "title": "Specification engineering specifications human-mirror template",
  "description": "Human mirror for artifacts/specifications/. Runtime uses entries[] in project-specification payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "summary", "required_sections", "created_at"],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "kind": { "const": "specifications" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "required_sections": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "string",
        "enum": [
          "project-overview",
          "functional",
          "non-functional",
          "architecture",
          "module",
          "feature",
          "api",
          "database",
          "ui",
          "security",
          "deployment",
          "coding-standards",
          "testing-strategy"
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
