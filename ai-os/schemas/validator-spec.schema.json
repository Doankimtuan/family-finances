{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/validator-spec.schema.json",
  "title": "AIOS Validator Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "applies_to",
    "checks",
    "fail_fast",
    "outputs",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
      },
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "severity",
          "rule"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "severity": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/severity"
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      }
    },
    "fail_fast": {
      "type": "boolean"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "none",
          "runtime-write",
          "external"
        ]
      },
      "default": [
        "none"
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "validation-report"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "status": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/packageStatus"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
