{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/solution-architecture-payload.schema.json",
  "title": "AIOS Solution Architecture Redesign Payload",
  "description": "Primary payloads for solution-architecture pipeline. Preserve business behavior; never invent business logic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "type",
    "worker_id",
    "title",
    "summary",
    "entries",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "type": {
      "type": "string",
      "enum": [
        "architecture-v2-spec",
        "architecture-decision-record",
        "tech-stack-recommendation",
        "migration-plan",
        "folder-structure-spec",
        "redesign-overview",
        "quality-notes"
      ]
    },
    "worker_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source_paths",
          "confidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "entry_kind": {
            "type": "string",
            "minLength": 1
          },
          "preserves_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preserves_behavior": {
            "type": "boolean"
          },
          "decision_status": {
            "type": "string",
            "enum": [
              "proposed",
              "accepted",
              "superseded",
              "rejected"
            ]
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trade_offs": {
            "type": "string"
          },
          "path_proposal": {
            "type": "string"
          },
          "folder_mirror": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "failed"
      ]
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "architecture-v2-spec"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "confidence",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "pattern",
                    "boundary",
                    "capability-map",
                    "adr",
                    "modularity"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tech-stack-recommendation"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "confidence",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "recommendation",
                    "comparison",
                    "migration-note"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "migration-plan"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "confidence",
                "entry_kind",
                "preserves_behavior"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "wave",
                    "refactor",
                    "risk",
                    "rollback"
                  ]
                },
                "preserves_behavior": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "folder-structure-spec"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "confidence",
                "entry_kind",
                "path_proposal"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "module",
                    "convention",
                    "boundary"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
