{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/registry.schema.json",
  "title": "AIOS Registry Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_kind",
    "updated_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "registry_kind": {
      "type": "string",
      "enum": [
        "skills",
        "validators",
        "reviewers",
        "artifact-types"
      ]
    },
    "updated_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "entries": {
      "type": "object",
      "description": "Map keyed by package/type id",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/packageStatus"
          },
          "description": {
            "type": "string"
          },
          "payload_kinds": {
            "type": "array",
            "items": {
              "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/payloadKind"
            }
          }
        }
      }
    }
  }
}
