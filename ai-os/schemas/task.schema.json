{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/task.schema.json",
  "title": "AIOS Task Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "title",
    "skill_id",
    "primary_output_type",
    "inputs",
    "done_when",
    "side_effect_budget",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "skill_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "skill_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/skillVersionPin"
    },
    "primary_output_type": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "artifact_id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
          },
          "artifact_version": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactVersionPin"
          },
          "from_task_id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
          },
          "required": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "validators": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "side_effect_budget": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/sideEffect"
      },
      "uniqueItems": true
    },
    "allow_parallel_attempts": {
      "type": "boolean",
      "default": false
    },
    "continue_on_cancel": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/taskStatus"
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
