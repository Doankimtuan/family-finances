{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/specification-engineering-payload.schema.json",
  "title": "AIOS Specification Engineering Payload",
  "description": "Primary payloads for specification-engineering. Never invent business logic. Spec entries require purpose/scope/actors/pre/post/workflow/business_rules/validation_rules/error_handling/edge_cases/dependencies/acceptance_criteria (or UNKNOWN). Mark gaps in unknowns[].",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "type",
    "worker_id",
    "title",
    "summary",
    "entries",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "type": {
      "type": "string",
      "enum": [
        "project-specification",
        "engineering-task-graph",
        "delivery-roadmap",
        "implementation-plan",
        "repository-notes"
      ]
    },
    "worker_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source_paths",
          "confidence",
          "entry_kind",
          "traceability",
          "unknowns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "entry_kind": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "postconditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          },
          "business_rules": {
            "type": "string",
            "minLength": 1
          },
          "validation_rules": {
            "type": "string",
            "minLength": 1
          },
          "error_handling": {
            "type": "string",
            "minLength": 1
          },
          "edge_cases": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workflow_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "business_rules_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "architecture_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "api_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "database_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "string"
          },
          "complexity": {
            "type": "string"
          },
          "definition_of_done": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "critical_path": {
            "type": "boolean"
          },
          "unknowns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Prefer prefix UNKNOWN: \u2026 ; use ['UNKNOWN: none noted'] when complete"
          },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_artifact"
            ],
            "properties": {
              "feature": {
                "type": "string"
              },
              "business_rule": {
                "type": "string"
              },
              "api": {
                "type": "string"
              },
              "database": {
                "type": "string"
              },
              "workflow": {
                "type": "string"
              },
              "architecture_decision": {
                "type": "string"
              },
              "source_artifact": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "folder_mirror": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "failed"
      ]
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "project-specification"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 13,
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "project-overview",
                    "functional",
                    "non-functional",
                    "architecture",
                    "module",
                    "feature",
                    "api",
                    "database",
                    "ui",
                    "security",
                    "deployment",
                    "coding-standards",
                    "testing-strategy",
                    "conflict",
                    "gap"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "not": {
                      "properties": {
                        "entry_kind": {
                          "enum": [
                            "conflict",
                            "gap"
                          ]
                        }
                      },
                      "required": [
                        "entry_kind"
                      ]
                    }
                  },
                  "then": {
                    "required": [
                      "purpose",
                      "scope",
                      "actors",
                      "preconditions",
                      "postconditions",
                      "workflow",
                      "business_rules",
                      "validation_rules",
                      "error_handling",
                      "edge_cases",
                      "dependencies",
                      "acceptance_criteria"
                    ],
                    "properties": {
                      "traceability": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "feature",
                          "business_rule",
                          "api",
                          "database",
                          "workflow",
                          "architecture_decision",
                          "source_artifact"
                        ],
                        "properties": {
                          "feature": {
                            "type": "string",
                            "minLength": 1
                          },
                          "business_rule": {
                            "type": "string",
                            "minLength": 1
                          },
                          "api": {
                            "type": "string",
                            "minLength": 1
                          },
                          "database": {
                            "type": "string",
                            "minLength": 1
                          },
                          "workflow": {
                            "type": "string",
                            "minLength": 1
                          },
                          "architecture_decision": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source_artifact": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "engineering-task-graph"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 4,
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "epic",
                    "feature",
                    "story",
                    "task",
                    "subtask",
                    "milestone",
                    "dependency"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "delivery-roadmap"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 4,
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "release",
                    "phase",
                    "sprint",
                    "milestone",
                    "risk",
                    "timeline",
                    "delivery-order"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "implementation-plan"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 4,
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "build-order",
                    "critical-path",
                    "parallel-work",
                    "blocked",
                    "graph-node",
                    "graph-edge"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "repository-notes"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "layout",
                    "module-map",
                    "constraint",
                    "note",
                    "gap"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
