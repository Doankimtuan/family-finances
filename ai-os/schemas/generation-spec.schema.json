{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/generation-spec.schema.json",
  "title": "Generation Capability Spec",
  "type": "object",
  "required": [
    "capability",
    "version",
    "target_generator",
    "modes"
  ],
  "properties": {
    "capability": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "target_generator": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "registries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semver": {
      "type": "string"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  }
}
