{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/gate-profile.schema.json",
  "title": "AIOS Gate Profile Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "profiles": {
      "type": "object",
      "required": [
        "strict",
        "standard",
        "advisory"
      ],
      "additionalProperties": false,
      "properties": {
        "strict": {
          "$ref": "#/$defs/profile"
        },
        "standard": {
          "$ref": "#/$defs/profile"
        },
        "advisory": {
          "$ref": "#/$defs/profile"
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocking_severities",
        "require_review_on_repo_write",
        "allow_publish_with_warn",
        "validators_blocking"
      ],
      "properties": {
        "blocking_severities": {
          "type": "array",
          "items": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/severity"
          }
        },
        "require_review_on_repo_write": {
          "type": "boolean"
        },
        "require_review_on_plan": {
          "type": "boolean"
        },
        "allow_publish_with_warn": {
          "type": "boolean"
        },
        "validators_blocking": {
          "type": "boolean"
        },
        "reviews_blocking": {
          "type": "boolean"
        }
      }
    }
  }
}
