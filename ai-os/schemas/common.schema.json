{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/common.schema.json",
  "title": "AIOS Common Definitions",
  "$comment": "All other schemas MUST $ref these $defs. Do not re-inline enums.",
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "isoDateTime": {
      "type": "string",
      "format": "date-time",
      "description": "UTC ISO-8601 timestamp"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "artifactId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^art_[A-Za-z0-9][A-Za-z0-9_-]*$",
      "description": "Sole durable identity prefix. Type is meta.type, not the ID prefix."
    },
    "kebabId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "artifactTypeId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "description": "Must exist in registry/artifact-types.json entries. Not a closed enum."
    },
    "artifactStatus": {
      "type": "string",
      "enum": ["draft", "ready", "published", "superseded", "archived"]
    },
    "runStatus": {
      "type": "string",
      "enum": ["pending", "claimed", "running", "succeeded", "failed", "cancelled"]
    },
    "taskStatus": {
      "type": "string",
      "enum": ["pending", "ready", "running", "succeeded", "failed", "blocked", "cancelled"]
    },
    "orchestrationStatus": {
      "type": "string",
      "enum": [
        "idle",
        "accepting",
        "planning",
        "scheduled",
        "running",
        "gating",
        "settling",
        "succeeded",
        "failed",
        "aborted",
        "superseded"
      ]
    },
    "packageStatus": {
      "type": "string",
      "enum": ["reserved", "draft", "active", "deprecated"]
    },
    "waveStatus": {
      "type": "string",
      "enum": ["pending", "running", "succeeded", "failed", "cancelled"]
    },
    "gateResult": {
      "type": "string",
      "enum": ["pass", "fail", "warn", "skip"]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "gateProfile": {
      "type": "string",
      "enum": ["strict", "standard", "advisory"]
    },
    "sideEffect": {
      "type": "string",
      "enum": ["none", "repo-write", "runtime-write", "external"]
    },
    "skillRole": {
      "type": "string",
      "enum": ["planner", "executor", "orchestrator-helper"],
      "description": "Validators and reviewers are separate package kinds, not skills."
    },
    "producerRole": {
      "type": "string",
      "enum": [
        "orchestrator",
        "planner",
        "executor",
        "validator",
        "reviewer",
        "orchestrator-helper",
        "human"
      ]
    },
    "artifactRelation": {
      "type": "string",
      "enum": [
        "requires",
        "derived-from",
        "reviews",
        "validates",
        "implements",
        "informs"
      ]
    },
    "edgeType": {
      "type": "string",
      "enum": ["blocks", "feeds", "informs"],
      "description": "predecessor must satisfy edge before successor may start (blocks/feeds are hard)."
    },
    "controlDecision": {
      "type": "string",
      "enum": ["continue", "retry", "replan", "abort", "escalate", "publish", "hold"],
      "description": "Unified control-plane decision vocabulary for orchestration and quality gates."
    },
    "runPhase": {
      "type": "string",
      "enum": [
        "claimed",
        "preparing",
        "executing",
        "persisting",
        "validating",
        "reviewing",
        "terminal"
      ]
    },
    "errorPhase": {
      "type": "string",
      "enum": [
        "intake",
        "claimed",
        "preparing",
        "executing",
        "persisting",
        "validating",
        "reviewing",
        "gating",
        "settling",
        "terminal"
      ]
    },
    "payloadKind": {
      "type": "string",
      "enum": ["json", "markdown", "patch", "binary"]
    },
    "payloadPath": {
      "type": "string",
      "enum": ["payload.json", "payload.md", "payload.patch", "payload.bin"],
      "description": "Canonical payload filenames only. Optional ARTIFACT.md is a human companion, never the payload path."
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "skillVersionPin": {
      "oneOf": [
        { "$ref": "#/$defs/semver" },
        { "type": "string", "const": "active" }
      ]
    },
    "artifactVersionPin": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "string", "const": "latest-in-run" }
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/artifactId" },
        "artifact_version": { "type": "integer", "minimum": 1 },
        "relation": { "$ref": "#/$defs/artifactRelation" }
      }
    },
    "traceContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required correlation fields for control-plane artifacts.",
      "properties": {
        "orchestration_id": { "$ref": "#/$defs/artifactId" },
        "goal_id": { "$ref": "#/$defs/artifactId" },
        "plan_id": { "$ref": "#/$defs/artifactId" },
        "task_id": { "$ref": "#/$defs/artifactId" },
        "run_id": { "$ref": "#/$defs/artifactId" }
      }
    },
    "errorObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "#/$defs/kebabId" },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retryable": { "type": "boolean" },
        "phase": { "$ref": "#/$defs/errorPhase" },
        "details": { "type": "object" }
      }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension bag",
      "additionalProperties": true
    }
  }
}
