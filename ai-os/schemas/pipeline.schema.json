{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/pipeline.schema.json",
  "title": "AIOS Worker Pipeline",
  "description": "Named pipeline binding registered workers into waves with an explicit dependency graph.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "version",
    "status",
    "worker_class",
    "allows_feature_workers",
    "side_effect_ceiling",
    "workers",
    "dependency_graph_ref",
    "waves",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/semver"
    },
    "status": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/packageStatus"
    },
    "worker_class": {
      "type": "string",
      "enum": [
        "discovery",
        "feature"
      ]
    },
    "gate_profile": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateProfile"
    },
    "allows_feature_workers": {
      "type": "boolean"
    },
    "side_effect_ceiling": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/sideEffect"
      },
      "uniqueItems": true
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "dependency_graph_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_id"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
        },
        "schema": {
          "type": "string"
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
        }
      }
    },
    "primary_output_type": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
    },
    "validator_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "reviewer_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "problem",
        "success_criteria",
        "non_goals"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "problem": {
          "type": "string"
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "non_goals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
