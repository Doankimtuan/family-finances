{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/product-knowledge-ingest/output.schema.json",
  "title": "AIOS Product RE Worker Output \u2014 product-knowledge-ingest",
  "description": "Run envelope for product-knowledge-ingest. Primary payload type: knowledge-notes.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "product-knowledge-ingest"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "product-re"
            },
            "primary_output_type": {
              "const": "knowledge-notes"
            },
            "produces": {
              "const": [
                "knowledge"
              ]
            }
          }
        }
      }
    }
  ]
}
