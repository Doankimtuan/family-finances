{
  "id": "case-02-budget-exceed",
  "title": "Side-effect budget exceeded",
  "description": "Worker must fail in preparing when skill/task side effects exceed orchestration budget.",
  "given": {
    "gate_profile": "standard",
    "orchestration_budget": {
      "allowed_side_effects": ["none", "runtime-write"]
    },
    "task": {
      "artifact_id": "art_tc02_task",
      "skill_id": "{{skill_id}}",
      "skill_version": "0.0.0",
      "primary_output_type": "{{artifact_type}}",
      "validators": [],
      "reviewers": [],
      "side_effect_budget": ["repo-write"]
    },
    "inputs": []
  },
  "when": {
    "action": "run-worker",
    "worker_id": "dependency-validator",
    "worker_version": "0.0.0"
  },
  "expect": {
    "run_status": "failed",
    "failed_phase": "preparing",
    "error_code": "side-effect-budget-exceeded",
    "published": false,
    "primary_output_created": false
  }
}
