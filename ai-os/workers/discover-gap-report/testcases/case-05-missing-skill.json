{
  "id": "case-05-missing-skill",
  "title": "Unknown skill fails preparing",
  "description": "Worker must fail in preparing when skill_id is not in registry/skills.json.",
  "given": {
    "gate_profile": "standard",
    "orchestration_budget": {
      "allowed_side_effects": [
        "none",
        "runtime-write"
      ]
    },
    "task": {
      "artifact_id": "art_tc05_task",
      "skill_id": "discover-gap-report",
      "skill_version": "0.1.0",
      "primary_output_type": "discovery-report",
      "validators": [
        "discovery-schema-check"
      ],
      "reviewers": [
        "discovery-coverage-review"
      ],
      "side_effect_budget": [
        "runtime-write"
      ]
    },
    "inputs": []
  },
  "when": {
    "action": "run-worker",
    "worker_id": "discover-gap-report",
    "worker_version": "0.1.0"
  },
  "expect": {
    "run_status": "failed",
    "failed_phase": "preparing",
    "error_code": "unknown-skill",
    "published": false,
    "primary_output_created": false
  }
}
