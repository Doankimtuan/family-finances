        "none",
        "runtime-write"
      ]
    },
    "task": {
      "artifact_id": "art_tc02_task",
      "skill_id": "specification-generator",
      "skill_version": "0.1.0",
      "primary_output_type": "project-specification",
      "validators": [
        "specification-engineering-schema-check"
      ],
      "reviewers": [
        "specification-engineering-coverage-review"
      ],
      "side_effect_budget": [
        "repo-write"
      ]
    },
    "inputs": []
  },
  "when": {
    "action": "run-worker",
    "worker_id": "specification-generator",
    "worker_version": "0.1.0"
  },
  "expect": {
    "run_status": "failed",
    "failed_phase": "preparing",
    "error_code": "side-effect-budget-exceeded",
    "published": false,
    "primary_output_created": false
  }
