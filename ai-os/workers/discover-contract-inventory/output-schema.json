{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/discover-contract-inventory/output.schema.json",
  "title": "AIOS Discovery Worker Output \u2014 discover-contract-inventory",
  "description": "Run envelope for discover-contract-inventory. Primary durable payload MUST validate schemas/discovery-report.schema.json.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "discover-contract-inventory"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "worker_class": {
              "const": "discovery"
            },
            "pipeline": {
              "const": "discovery"
            },
            "primary_payload_schema": {
              "const": "schemas/discovery-report.schema.json"
            }
          }
        }
      }
    }
  ]
}
