{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/refactoring-consultant/output.schema.json",
  "title": "AIOS Solution Architecture Worker Output \u2014 refactoring-consultant",
  "description": "Run envelope for refactoring-consultant. Primary: migration-plan.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "refactoring-consultant"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "solution-architecture"
            },
            "primary_output_type": {
              "const": "migration-plan"
            },
            "produces": {
              "const": [
                "migration",
                "redesign"
              ]
            }
          }
        }
      }
    }
  ]
}
