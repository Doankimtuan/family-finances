{
  "schema_version": "1.0.0",
  "id": "runtime-engine-schema-check",
  "version": "0.1.0",
  "title": "Runtime Engine Schema Check",
  "description": "Deterministic checks for runtime-engine payloads.",
  "applies_to": [
    "runtime-status",
    "runtime-event",
    "runtime-log",
    "runtime-command",
    "runtime-plan",
    "runtime-checkpoint",
    "runtime-execution-report",
    "gate-runtime-report"
  ],
  "checks": [
    {
      "check_id": "schema-valid",
      "severity": "critical",
      "rule": "payload validates against runtime-engine-payload.schema.json"
    },
    {
      "check_id": "folder-mirror-partition",
      "severity": "critical",
      "rule": "folder_mirror under runtime/"
    },
    {
      "check_id": "raci-entry-kind",
      "severity": "critical",
      "rule": "entry_kind owned by worker_id per RACI.md"
    },
    {
      "check_id": "orchestrate-only",
      "severity": "critical",
      "rule": "mutate_workers/validators/reviewers must be false"
    },
    {
      "check_id": "no-worker-execution",
      "severity": "critical",
      "rule": "execute_workers must be false in packaging"
    },
    {
      "check_id": "plan-before-execute",
      "severity": "high",
      "rule": "execution-planner emits plans; never execute immediately"
    },
    {
      "check_id": "command-registry",
      "severity": "high",
      "rule": "command-interpreter kinds \u2286 command-registry.json"
    },
    {
      "check_id": "circular-rejection",
      "severity": "high",
      "rule": "dependency-resolver documents circular-rejection"
    }
  ]
}
