      {
        "id": "product-ready",
        "description": "product-analyst emits ready product-model"
      },
      {
        "id": "workflow-ready",
        "description": "workflow-analyzer emits ready workflow-model"
      },
      {
        "id": "requirements-ready",
        "description": "requirement-generator emits ready requirement-spec"
      },
      {
        "id": "acceptance-ready",
        "description": "acceptance-criteria-generator emits ready acceptance-criteria"
      },
      {
        "id": "gaps-ready",
        "description": "product-re-gap-report emits ready product-re-gap"
      }
    ],
    "non_goals": [
      "Redesign the product",
      "Implement Feature Workers",
      "Mutate application source under repo-write",
      "Treat ai-os/architecture/ as product architecture input"
    ]
  },
  "created_at": "2026-08-01T14:00:00Z",
  "extensions": {
