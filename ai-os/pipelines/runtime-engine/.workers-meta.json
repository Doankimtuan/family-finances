{
  "runtime-configuration-loader": {
    "wave": 0,
    "partition": "runtime/configs/runtime-configuration-loader/",
    "entry_kinds": [
      "aios-yaml",
      "run-yaml",
      "workspace-yaml",
      "env-vars",
      "defaults",
      "normalized-config"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "event-bus": {
    "wave": 0,
    "partition": "runtime/events/event-bus/",
    "entry_kinds": [
      "worker-started",
      "worker-finished",
      "validation-started",
      "validation-finished",
      "review-started",
      "review-finished",
      "phase-completed",
      "checkpoint-created",
      "execution-completed",
      "execution-failed"
    ],
    "produces": [
      "runtime-event"
    ]
  },
  "logging-engine": {
    "wave": 0,
    "partition": "runtime/logs/logging-engine/",
    "entry_kinds": [
      "execution-log",
      "worker-log",
      "validation-log",
      "review-log",
      "failure-log",
      "performance-log"
    ],
    "produces": [
      "runtime-log"
    ]
  },
  "command-interpreter": {
    "wave": 1,
    "partition": "runtime/commands/command-interpreter/",
    "entry_kinds": [
      "run-full",
      "run-incremental",
      "run-phase",
      "run-resume",
      "run-retry",
      "run-validate",
      "run-review",
      "run-freeze",
      "run-status",
      "run-benchmark"
    ],
    "produces": [
      "runtime-command"
    ]
  },
  "dependency-resolver": {
    "wave": 1,
    "partition": "runtime/scheduler/dependency-resolver/",
    "entry_kinds": [
      "worker-dependency",
      "artifact-dependency",
      "pipeline-dependency",
      "execution-dependency",
      "circular-rejection"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "execution-context-manager": {
    "wave": 1,
    "partition": "runtime/state/execution-context-manager/",
    "entry_kinds": [
      "current-phase",
      "completed-workers",
      "execution-state",
      "temporary-memory",
      "shared-context",
      "worker-outputs",
      "global-variables"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "artifact-manager": {
    "wave": 1,
    "partition": "runtime/execution/artifact-manager/",
    "entry_kinds": [
      "artifact-track",
      "artifact-version",
      "artifact-lifecycle",
      "artifact-ownership",
      "artifact-dependency"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "execution-planner": {
    "wave": 2,
    "partition": "runtime/execution/execution-planner/",
    "entry_kinds": [
      "execution-graph",
      "worker-order",
      "estimated-outputs",
      "estimated-runtime",
      "validation-plan",
      "review-plan",
      "checkpoint-plan"
    ],
    "produces": [
      "runtime-plan"
    ]
  },
  "checkpoint-manager": {
    "wave": 2,
    "partition": "runtime/checkpoint/checkpoint-manager/",
    "entry_kinds": [
      "phase-checkpoint",
      "validation-checkpoint",
      "retry-checkpoint",
      "freeze-checkpoint",
      "rollback-plan"
    ],
    "produces": [
      "runtime-checkpoint"
    ]
  },
  "progress-tracker": {
    "wave": 2,
    "partition": "runtime/state/progress-tracker/",
    "entry_kinds": [
      "overall-progress",
      "current-phase-status",
      "worker-status",
      "execution-time",
      "estimated-completion",
      "generated-artifacts",
      "quality-status"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "worker-scheduler": {
    "wave": 3,
    "partition": "runtime/scheduler/worker-scheduler/",
    "entry_kinds": [
      "worker-selection",
      "execution-order",
      "dedupe-guard",
      "priority",
      "concurrency"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "retry-engine": {
    "wave": 4,
    "partition": "runtime/execution/retry-engine/",
    "entry_kinds": [
      "retry-worker",
      "retry-phase",
      "retry-validation",
      "retry-review",
      "retry-updated-context",
      "retry-limits"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "resume-engine": {
    "wave": 4,
    "partition": "runtime/resume/resume-engine/",
    "entry_kinds": [
      "resume-checkpoint",
      "resume-failed-worker",
      "resume-failed-phase",
      "resume-interrupted"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "pipeline-engine": {
    "wave": 5,
    "partition": "runtime/execution/pipeline-engine/",
    "entry_kinds": [
      "sequential-execution",
      "parallel-execution",
      "conditional-execution",
      "dynamic-execution",
      "resume-execution",
      "incremental-execution"
    ],
    "produces": [
      "runtime-status"
    ]
  },
  "master-orchestrator": {
    "wave": 6,
    "partition": "runtime/orchestrator/master-orchestrator/",
    "entry_kinds": [
      "load-config",
      "load-pipeline",
      "load-workers",
      "resolve-dependencies",
      "execute-pipeline",
      "handle-failure",
      "handle-retry",
      "handle-resume",
      "freeze-phase",
      "execution-summary"
    ],
    "produces": [
      "runtime-execution-report"
    ]
  }
}
