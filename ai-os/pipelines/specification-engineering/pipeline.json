  "primary_output_type": "project-specification",
  "validator_id": "specification-engineering-schema-check",
  "reviewer_id": "specification-engineering-coverage-review",
  "goal": {
    "title": "Produce implementation-ready specifications and plans from validated knowledge",
    "problem": "Transform validated Product RE + Solution Architecture artifacts into specifications, tasks, roadmap, and implementation plan without inventing business logic.",
    "success_criteria": [
      {
        "id": "specs-ready",
        "description": "specification-generator emits ready project-specification with 13 sections or explicit gaps"
      },
      {
        "id": "tasks-ready",
        "description": "task-generator emits ready engineering-task-graph (epic/feature|story/task + deps)"
      },
      {
        "id": "roadmap-ready",
        "description": "roadmap-generator emits ready delivery-roadmap (phase|release + delivery-order + risk)"
      },
      {
        "id": "implementation-ready",
        "description": "implementation-planner emits ready implementation-plan (build-order + critical-path + parallel|blocked)"
      }
    ],
    "non_goals": [
      "Execute workers / generate live project specs in this milestone",
      "Invent business logic",
      "Redesign the system",
      "Change business requirements",
      "Implement Feature Workers",
      "Overwrite validated upstream artifacts",
      "Treat AIOS architecture/ as product architecture input",
      "Author repository/ notes (human/pre-step owns soft input)"
    ]
  },
  "created_at": "2026-08-01T15:00:00Z",
