{
  "artifact-validator": {
    "wave": 0,
    "depends": [],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "folder-structure",
      "required-files",
      "artifact-existence",
      "naming",
      "output-location",
      "artifact-contract",
      "pass",
      "fail"
    ],
    "description": "Verify folder structure, required files, artifact existence, naming, output locations, and artifact contracts. Never modify artifacts."
  },
  "schema-validator": {
    "wave": 0,
    "depends": [],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "json-schema",
      "markdown-structure",
      "required-fields",
      "data-types",
      "schema-compatibility",
      "pass",
      "fail"
    ],
    "description": "Validate JSON Schemas, markdown structure, required fields, data types, and schema compatibility. Never modify artifacts."
  },
  "dependency-validator": {
    "wave": 1,
    "depends": [
      "artifact-validator",
      "schema-validator"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "worker-dependency",
      "pipeline-dependency",
      "circular",
      "missing-dependency",
      "invalid-reference",
      "pass",
      "fail"
    ],
    "description": "Verify worker/pipeline dependencies, detect circular and missing dependencies and invalid references. Never modify artifacts."
  },
  "pipeline-validator": {
    "wave": 1,
    "depends": [
      "artifact-validator",
      "schema-validator"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "execution-order",
      "stage-dependency",
      "pipeline-registration",
      "worker-registration",
      "lifecycle",
      "resume",
      "incremental",
      "pass",
      "fail"
    ],
    "description": "Verify execution order, stage dependencies, pipeline/worker registration, lifecycle, resume and incremental support. Never modify artifacts."
  },
  "traceability-validator": {
    "wave": 2,
    "depends": [
      "dependency-validator",
      "pipeline-validator"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "feature-trace",
      "business-rule-trace",
      "architecture-trace",
      "requirement-trace",
      "knowledge-trace",
      "orphan",
      "pass",
      "fail"
    ],
    "description": "Verify every artifact traces to features, business rules, architecture, requirements, knowledge. Reject orphans. Never modify artifacts."
  },
  "completeness-validator": {
    "wave": 2,
    "depends": [
      "dependency-validator",
      "pipeline-validator"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "missing-document",
      "missing-field",
      "missing-module",
      "missing-specification",
      "missing-worker",
      "missing-example",
      "missing-schema",
      "pass",
      "fail"
    ],
    "description": "Verify missing documents, fields, modules, specifications, workers, examples, schemas. Never invent missing information \u2014 only report."
  },
  "consistency-validator": {
    "wave": 2,
    "depends": [
      "dependency-validator",
      "pipeline-validator"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-finding",
    "entry_kinds": [
      "contradiction",
      "duplication",
      "conflicting-requirement",
      "conflicting-architecture",
      "conflicting-business-rule",
      "naming-inconsistency",
      "pass",
      "fail"
    ],
    "description": "Detect contradictions, duplications, conflicting requirements/architecture/business rules, naming inconsistencies. Never modify artifacts."
  },
  "quality-scoring-engine": {
    "wave": 3,
    "depends": [
      "artifact-validator",
      "schema-validator",
      "dependency-validator",
      "pipeline-validator",
      "traceability-validator",
      "completeness-validator",
      "consistency-validator"
    ],
    "produces": [
      "scores"
    ],
    "primary": "quality-scores",
    "entry_kinds": [
      "overall",
      "architecture",
      "documentation",
      "consistency",
      "completeness",
      "maintainability",
      "extensibility",
      "reliability",
      "confidence"
    ],
    "description": "Generate structured quality scores from validation findings. Never modify source artifacts; never invent missing data."
  },
  "validation-orchestrator": {
    "wave": 4,
    "depends": [
      "artifact-validator",
      "schema-validator",
      "dependency-validator",
      "pipeline-validator",
      "traceability-validator",
      "completeness-validator",
      "consistency-validator",
      "quality-scoring-engine"
    ],
    "produces": [
      "validation"
    ],
    "primary": "validation-status",
    "entry_kinds": [
      "plan",
      "order",
      "merge",
      "overall-status",
      "incremental",
      "partial"
    ],
    "description": "Coordinate validation order (from pipeline waves), merge findings, emit overall validation status. Never modify source artifacts."
  },
  "validation-reporter": {
    "wave": 5,
    "depends": [
      "validation-orchestrator",
      "quality-scoring-engine"
    ],
    "produces": [
      "reports"
    ],
    "primary": "validation-report",
    "entry_kinds": [
      "summary",
      "critical",
      "high",
      "medium",
      "low",
      "recommended-fix",
      "decision"
    ],
    "description": "Generate validation summary, severity-ranked issues, recommended fixes, and PASS/FAIL decision. Machine-readable only."
  }
}
