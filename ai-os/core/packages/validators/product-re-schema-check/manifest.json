{
  "schema_version": "1.0.0",
  "id": "product-re-schema-check",
  "version": "0.2.1",
  "title": "Product RE Schema Check",
  "description": "Deterministic schema and type-specific checks for product-re primary payloads.",
  "applies_to": [
    "knowledge-notes",
    "feature-inventory",
    "business-rules",
    "product-architecture-notes",
    "product-model",
    "workflow-model",
    "requirement-spec",
    "acceptance-criteria",
    "product-re-gap"
  ],
  "checks": [
    {
      "check_id": "schema-valid",
      "severity": "critical",
      "rule": "payload validates against core/packages/schemas/product-re-payload.schema.json (and typed schema for payload.type)",
      "path": "payload.json"
    },
    {
      "check_id": "type-known",
      "severity": "critical",
      "rule": "payload.type is a registered product-re artifact type",
      "path": "$.type"
    },
    {
      "check_id": "entries-nonempty",
      "severity": "critical",
      "rule": "entries array has at least one item",
      "path": "$.entries"
    },
    {
      "check_id": "source-paths-required",
      "severity": "critical",
      "rule": "every entry has non-empty source_paths[]",
      "path": "$.entries[*].source_paths"
    },
    {
      "check_id": "workflow-step-fields",
      "severity": "high",
      "rule": "when type=workflow-model, each entry has actor and step_order",
      "path": "$.entries[*]"
    },
    {
      "check_id": "acceptance-requirement-link",
      "severity": "high",
      "rule": "when type=acceptance-criteria, each entry has requirement_id",
      "path": "$.entries[*].requirement_id"
    },
    {
      "check_id": "requirement-shall-language",
      "severity": "high",
      "rule": "when type=requirement-spec, statement contains SHALL or MUST",
      "path": "$.entries[*].statement"
    },
    {
      "check_id": "no-aios-architecture-consume",
      "severity": "critical",
      "rule": "source_paths must not point at ai-os/architecture/ control-plane docs as product input",
      "path": "$.entries[*].source_paths"
    },
    {
      "check_id": "no-redesign-flag",
      "severity": "medium",
      "rule": "extensions.redesign is not true",
      "path": "$.extensions.redesign"
    },
    {
      "check_id": "ingest-entry-kind-known",
      "severity": "high",
      "rule": "when type is ingest, entry_kind is in the type allow-list (glossary/entity/fact, surface/route/action, rule/invariant/policy, pillar/boundary/module)",
      "path": "$.entries[*].entry_kind"
    },
    {
      "check_id": "product-model-kinds-present",
      "severity": "medium",
      "rule": "when type=product-model, entry_kind set should cover identity and preferably persona|value-prop|capability",
      "path": "$.entries[*].entry_kind"
    }
  ],
  "fail_fast": true,
  "side_effects": [
    "none"
  ],
  "outputs": [
    "validation-report"
  ],
  "status": "reserved",
  "extensions": {
    "pipeline": "product-re",
    "typed_schemas": {
      "product-model": "core/packages/schemas/product-model.schema.json",
      "workflow-model": "core/packages/schemas/workflow-model.schema.json",
      "requirement-spec": "core/packages/schemas/requirement-spec.schema.json",
      "acceptance-criteria": "core/packages/schemas/acceptance-criteria.schema.json",
      "knowledge-notes": "core/packages/schemas/product-re-ingest.schema.json",
      "feature-inventory": "core/packages/schemas/product-re-ingest.schema.json",
      "business-rules": "core/packages/schemas/product-re-ingest.schema.json",
      "product-architecture-notes": "core/packages/schemas/product-re-ingest.schema.json",
      "product-re-gap": "core/packages/schemas/product-re-gap.schema.json"
    }
  }
}
