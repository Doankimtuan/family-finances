      },
      {
        "id": "status-merged",
        "description": "validation-orchestrator merges partitioned findings and records pipeline wave order"
      },
      {
        "id": "report-ready",
        "description": "validation-reporter emits ready validation-report with severity kinds + PASS/FAIL"
      }
    ],
    "non_goals": [
