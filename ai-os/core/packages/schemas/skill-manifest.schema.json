{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/skill-manifest.schema.json",
  "title": "AIOS Skill Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "role",
    "grade",
    "inputs",
    "outputs",
    "side_effects",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "role": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/skillRole"
    },
    "grade": {
      "type": "string",
      "enum": [
        "strict",
        "guided",
        "open"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "artifact_type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "artifact_type": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "artifact_type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "artifact_type": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
          },
          "primary": {
            "type": "boolean",
            "default": false
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "requires_skills": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "validators": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "reviewers": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "side_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/sideEffect"
      },
      "uniqueItems": true
    },
    "status": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/packageStatus"
    },
    "entrypoint": {
      "type": "string",
      "default": "SKILL.md"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
