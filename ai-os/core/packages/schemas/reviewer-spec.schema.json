{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/reviewer-spec.schema.json",
  "title": "AIOS Reviewer Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "description",
    "applies_to",
    "rubric_id",
    "rubric_version",
    "score_mode",
    "criteria",
    "outputs",
    "status"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactTypeId"
      },
      "uniqueItems": true
    },
    "requires_validations": {
      "type": "array",
      "items": {
        "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
      },
      "uniqueItems": true
    },
    "rubric_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "score_mode": {
      "type": "string",
      "enum": [
        "weighted_0_1",
        "average_1_5"
      ]
    },
    "pass_threshold": {
      "type": "number"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "weight",
          "scale_min",
          "scale_max"
        ],
        "properties": {
          "id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
          },
          "description": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scale_min": {
            "type": "integer"
          },
          "scale_max": {
            "type": "integer"
          },
          "anchors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "veto_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "const": "review-report"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "status": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/packageStatus"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
