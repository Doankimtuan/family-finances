{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/quality-gate.schema.json",
  "title": "AIOS Quality Gate Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "profile",
    "subject",
    "validation_results",
    "review_results",
    "result",
    "decision",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "orchestration_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "profile": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateProfile"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "artifact",
            "task",
            "wave",
            "orchestration"
          ]
        },
        "id": {
          "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
        },
        "artifact_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "result"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
          },
          "result": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateResult"
          }
        }
      }
    },
    "review_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "result"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
          },
          "result": {
            "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateResult"
          }
        }
      }
    },
    "result": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateResult"
    },
    "decision": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/controlDecision"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
