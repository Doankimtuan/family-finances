{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/product-re-payload.schema.json",
  "title": "AIOS Product Reverse Engineering Payload",
  "description": "Umbrella primary payload for product-re artifact types. Type-specific constraints via allOf if/then. Folder TEMPLATE.md / template.schema.json are human mirrors; runtime source of truth is entries[] payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "type",
    "worker_id",
    "title",
    "summary",
    "entries",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "type": {
      "type": "string",
      "enum": [
        "knowledge-notes",
        "feature-inventory",
        "business-rules",
        "product-architecture-notes",
        "product-model",
        "workflow-model",
        "requirement-spec",
        "acceptance-criteria",
        "product-re-gap"
      ]
    },
    "worker_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "source_paths"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entry_kind": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 2
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "step_order": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "folder_mirror": {
            "type": "string",
            "description": "Optional ai-os/ relative path for published folder mirror"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "failed"
      ]
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "product-model"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "identity",
                    "persona",
                    "value-prop",
                    "capability"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "workflow-model"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "actor",
                "step_order"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "requirement-spec"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "const": "shall"
                },
                "statement": {
                  "pattern": "\\b(SHALL|MUST|Shall|Must|shall|must)\\b"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "acceptance-criteria"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "requirement_id",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "given",
                    "when",
                    "then",
                    "gwt"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "product-re-gap"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "knowledge-notes"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "glossary",
                    "entity",
                    "fact"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "feature-inventory"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "surface",
                    "route",
                    "action"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "business-rules"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "rule",
                    "invariant",
                    "policy"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "product-architecture-notes"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "statement",
                "source_paths",
                "entry_kind"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "pillar",
                    "boundary",
                    "module"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
