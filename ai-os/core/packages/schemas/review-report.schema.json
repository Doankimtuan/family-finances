{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/review-report.schema.json",
  "title": "AIOS Review Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "reviewer_id",
    "reviewer_version",
    "rubric_id",
    "rubric_version",
    "reviewed_artifact",
    "result",
    "score_total",
    "criteria",
    "summary",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "reviewer_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "reviewer_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/semver"
    },
    "rubric_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "rubric_version": {
      "type": "string"
    },
    "run_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "reviewed_artifact": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactRef"
    },
    "result": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/gateResult"
    },
    "score_total": {
      "type": "number"
    },
    "normalized_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Always 0..1 regardless of score_mode"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "vetoes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "recommendation": {
      "type": "string",
      "enum": [
        "ship",
        "revise",
        "reject"
      ]
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  }
}
