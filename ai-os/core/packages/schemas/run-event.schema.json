{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/run-event.schema.json",
  "title": "AIOS Run Event (events.jsonl line)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "event",
    "run_id"
  ],
  "properties": {
    "timestamp": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "event": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "run_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "phase": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/runPhase"
    },
    "detail": {
      "type": "object"
    }
  }
}
