{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/product-re-ingest.schema.json",
  "title": "AIOS Product RE Ingest Payload",
  "description": "Typed ingest payloads that populate artifacts/knowledge/, artifacts/features/, artifacts/business/, or artifacts/product-architecture/ mirrors.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/product-re-payload.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "knowledge-notes",
            "feature-inventory",
            "business-rules",
            "product-architecture-notes"
          ]
        }
      }
    }
  ]
}
