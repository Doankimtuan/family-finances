{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/review-engine-payload.schema.json",
  "title": "AIOS Review Engine Payload",
  "description": "Review Engine payloads v0.8.1. Never modify sources. Never regenerate. Never validate schemas. Never invent. Findings: folder_mirror governance/reviews/<worker_id>/. Governance: folder_mirror decisions|recommendations|improvements|governance/final-decision-board/. statement=one-line summary; finding=detailed rationale.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "type",
    "worker_id",
    "title",
    "summary",
    "entries",
    "status",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/schemaVersion"
    },
    "artifact_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/artifactId"
    },
    "type": {
      "type": "string",
      "enum": [
        "review-finding",
        "review-status",
        "review-scores",
        "governance-decision"
      ]
    },
    "worker_id": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/kebabId"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entry_kind",
          "statement",
          "review_id",
          "target",
          "finding",
          "evidence",
          "impact",
          "severity",
          "recommendation",
          "alternative_solution",
          "confidence",
          "source_paths",
          "unknowns",
          "traceability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2
          },
          "entry_kind": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "review_id": {
            "type": "string",
            "minLength": 2
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "impact": {
            "type": "string",
            "minLength": 1,
            "not": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low",
                "info"
              ]
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "alternative_solution": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknowns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "traceability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_artifact"
            ],
            "properties": {
              "source_artifact": {
                "type": "string",
                "minLength": 1
              },
              "feature": {
                "type": "string"
              },
              "requirement": {
                "type": "string"
              },
              "specification": {
                "type": "string"
              },
              "validation": {
                "type": "string"
              },
              "validation_report": {
                "type": "string"
              },
              "business_rule": {
                "type": "string"
              },
              "architecture_decision": {
                "type": "string"
              },
              "knowledge": {
                "type": "string"
              },
              "worker": {
                "type": "string"
              },
              "pipeline": {
                "type": "string"
              }
            }
          },
          "score_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "folder_mirror": {
            "type": "string",
            "minLength": 1
          },
          "priority_rank": {
            "type": "integer",
            "minimum": 1
          },
          "depends_on_reviews": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "failed"
      ]
    },
    "created_at": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/isoDateTime"
    },
    "trace": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/traceContext"
    },
    "extensions": {
      "$ref": "https://aios.dev/schemas/common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "review-finding"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "required": [
                "id",
                "entry_kind",
                "statement",
                "review_id",
                "target",
                "finding",
                "evidence",
                "impact",
                "severity",
                "recommendation",
                "alternative_solution",
                "confidence",
                "source_paths",
                "unknowns",
                "traceability",
                "folder_mirror"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "acceptance-criteria",
                    "ai-reliability",
                    "api-contracts",
                    "architecture-decisions",
                    "architecture-quality",
                    "architecture-scalability",
                    "artifact-design",
                    "business-alignment",
                    "business-completeness",
                    "business-rules",
                    "code-organization",
                    "coding-standards",
                    "cohesion",
                    "complexity",
                    "consistency",
                    "coupling",
                    "cross-references",
                    "customization",
                    "database-contracts",
                    "deployment-scalability",
                    "deployment-specifications",
                    "documentation-quality",
                    "domain-logic",
                    "edge-cases",
                    "examples",
                    "execution-model",
                    "feature-coverage",
                    "formatting",
                    "future-features",
                    "future-growth",
                    "future-maintainability",
                    "hallucination-risks",
                    "layering",
                    "missing-product-features",
                    "module-boundaries",
                    "module-isolation",
                    "module-size",
                    "naming",
                    "patterns",
                    "performance-risks",
                    "permission-rules",
                    "pipeline-design",
                    "plugin-support",
                    "product-vision",
                    "prompt-quality",
                    "readability",
                    "requirement-coverage",
                    "requirements",
                    "reuse-potential",
                    "separation-of-concerns",
                    "specifications",
                    "state-transitions",
                    "technical-debt-risk",
                    "testing-strategy",
                    "traceability-review",
                    "ui-specifications",
                    "user-journey",
                    "worker-responsibilities",
                    "workflow-consistency"
                  ]
                },
                "folder_mirror": {
                  "type": "string",
                  "pattern": "^governance/reviews/[a-z0-9-]+/"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "review-status"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 6,
            "items": {
              "properties": {
                "entry_kind": {
                  "enum": [
                    "plan",
                    "order",
                    "merge",
                    "dedupe",
                    "overall-status",
                    "consolidated-result",
                    "partial",
                    "incremental"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "review-scores"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 10,
            "items": {
              "required": [
                "id",
                "entry_kind",
                "statement",
                "review_id",
                "target",
                "finding",
                "evidence",
                "impact",
                "severity",
                "recommendation",
                "alternative_solution",
                "confidence",
                "source_paths",
                "unknowns",
                "traceability",
                "score_value"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "architecture",
                    "business",
                    "product",
                    "documentation",
                    "specifications",
                    "maintainability",
                    "scalability",
                    "extensibility",
                    "ai-reliability",
                    "overall-engineering-quality"
                  ]
                },
                "score_value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "governance-decision"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 7,
            "items": {
              "required": [
                "id",
                "entry_kind",
                "statement",
                "review_id",
                "target",
                "finding",
                "evidence",
                "impact",
                "severity",
                "recommendation",
                "alternative_solution",
                "confidence",
                "source_paths",
                "unknowns",
                "traceability",
                "folder_mirror"
              ],
              "properties": {
                "entry_kind": {
                  "enum": [
                    "summary",
                    "overall-recommendation",
                    "critical-risks",
                    "improvement-plan",
                    "go-no-go",
                    "release-recommendation",
                    "decision"
                  ]
                },
                "folder_mirror": {
                  "type": "string",
                  "pattern": "^(decisions|recommendations|improvements|governance)/final-decision-board/"
                }
              }
            }
          }
        }
      }
    }
  ]
}
