{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/architecture-consultant/output.schema.json",
  "title": "AIOS Solution Architecture Worker Output \u2014 architecture-consultant",
  "description": "Run envelope for architecture-consultant. Primary: architecture-v2-spec.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "architecture-consultant"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "solution-architecture"
            },
            "primary_output_type": {
              "const": "architecture-v2-spec"
            },
            "produces": {
              "const": [
                "architecture-v2",
                "decision-records",
                "redesign"
              ]
            }
          }
        }
      }
    }
  ]
}
