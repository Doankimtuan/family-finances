{
  "id": "case-04-blocking-review-fail",
  "title": "Blocking review prevents publish",
  "description": "When reviews_blocking is true, a fail/veto must fail the run and leave outputs unpublished.",
  "given": {
    "gate_profile": "standard",
    "orchestration_budget": {
      "allowed_side_effects": [
        "none",
        "runtime-write"
      ]
    },
    "task": {
      "artifact_id": "art_tc04_task",
      "skill_id": "discover-gap-report",
      "skill_version": "0.1.0",
      "primary_output_type": "discovery-report",
      "validators": [
        "discovery-schema-check"
      ],
      "reviewers": [
        "discovery-coverage-review"
      ],
      "side_effect_budget": [
        "runtime-write"
      ]
    },
    "validator_stub_result": "pass",
    "reviewer_stub_result": "fail"
  },
  "when": {
    "action": "run-worker",
    "worker_id": "discover-gap-report",
    "worker_version": "0.1.0"
  },
  "expect": {
    "run_status": "failed",
    "failed_phase": "reviewing",
    "artifact_statuses": {
      "primary_output": "ready",
      "validation_report": "ready",
      "review_report": "ready"
    },
    "published": false
  }
}
