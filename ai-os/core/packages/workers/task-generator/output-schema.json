{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/task-generator/output.schema.json",
  "title": "AIOS Specification Engineering Worker Output \u2014 task-generator",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "task-generator"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "specification-engineering"
            },
            "primary_output_type": {
              "const": "engineering-task-graph"
            },
            "produces": {
              "const": [
                "tasks"
              ]
            }
          }
        }
      }
    }
  ]
}
