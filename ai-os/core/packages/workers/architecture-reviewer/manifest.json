{
  "schema_version": "1.0.0",
  "id": "architecture-reviewer",
  "version": "0.1.1",
  "title": "Architecture Reviewer",
  "implements_roles": [
    "executor"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "entrypoint": "skill.md",
  "status": "draft",
  "extensions": {
    "worker_class": "discovery",
    "pipeline": "review-engine",
    "mutate_source_artifacts": false,
    "regenerate_outputs": false,
    "validate_schemas": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "partition": "governance/reviews/architecture-reviewer/",
    "remediation": "0.8.1"
  }
}
