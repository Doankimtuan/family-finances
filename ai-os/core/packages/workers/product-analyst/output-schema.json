{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/product-analyst/output.schema.json",
  "title": "AIOS Product RE Worker Output \u2014 product-analyst",
  "description": "Run envelope for product-analyst. Primary payload type: product-model.",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "product-analyst"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "product-re"
            },
            "primary_output_type": {
              "const": "product-model"
            },
            "produces": {
              "const": [
                "product"
              ]
            }
          }
        }
      }
    }
  ]
}
