{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aios.dev/schemas/workers/validation-reporter/output.schema.json",
  "title": "AIOS Validation Engine Worker Output \u2014 validation-reporter",
  "allOf": [
    {
      "$ref": "https://aios.dev/schemas/worker-output-envelope.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "worker_id": {
          "const": "validation-reporter"
        },
        "extensions": {
          "type": "object",
          "properties": {
            "pipeline": {
              "const": "validation-engine"
            },
            "primary_output_type": {
              "const": "validation-report"
            },
            "produces": {
              "const": [
                "reports"
              ]
            },
            "mutate_source_artifacts": {
              "const": false
            }
          }
        }
      }
    }
  ]
}
