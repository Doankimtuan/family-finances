{
  "id": "case-03-blocking-validation-fail",
  "title": "Blocking validation prevents publish",
  "description": "When validators_blocking is true, a fail result must fail the run and leave outputs unpublished.",
  "given": {
    "gate_profile": "standard",
    "orchestration_budget": {
      "allowed_side_effects": ["none", "runtime-write"]
    },
    "task": {
      "artifact_id": "art_tc03_task",
      "skill_id": "{{skill_id}}",
      "skill_version": "0.0.0",
      "primary_output_type": "{{artifact_type}}",
      "validators": ["{{validator_id}}"],
      "reviewers": [],
      "side_effect_budget": ["runtime-write"]
    },
    "validator_stub_result": "fail"
  },
  "when": {
    "action": "run-worker",
    "worker_id": "validation-orchestrator",
    "worker_version": "0.0.0"
  },
  "expect": {
    "run_status": "failed",
    "failed_phase": "validating",
    "artifact_statuses": {
      "primary_output": "ready",
      "validation_report": "ready"
    },
    "published": false
  }
}
