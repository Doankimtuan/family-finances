      "weight": 0.2,
      "scale_min": 0,
      "scale_max": 1
    },
    {
      "id": "honesty",
      "description": "Unknowns honest; no invented missing info; RACI respected",
      "weight": 0.15,
      "scale_min": 0,
      "scale_max": 1
