{
  "schema_version": "1.0.0",
  "id": "solution-architecture-coverage-review",
  "version": "0.1.0",
  "title": "Solution Architecture Coverage Review",
  "description": "Coverage review for solution redesign outputs. Veto invented business logic or discovery overwrite.",
  "applies_to": [
    "architecture-v2-spec",
    "architecture-decision-record",
    "tech-stack-recommendation",
    "migration-plan",
    "folder-structure-spec",
    "redesign-overview"
  ],
  "requires_validations": [
    "solution-architecture-schema-check"
  ],
  "rubric_id": "solution-architecture-coverage",
  "rubric_version": "0.1.0",
  "score_mode": "weighted_0_1",
  "pass_threshold": 0.7,
  "criteria": [
    {
      "id": "traceability",
      "description": "Entries cite validated consume sources",
      "weight": 0.3,
      "scale_min": 0,
      "scale_max": 1
    },
    {
      "id": "behavior-preservation",
      "description": "Recommendations preserve validated business behavior",
      "weight": 0.3,
      "scale_min": 0,
      "scale_max": 1
    },
    {
      "id": "confidence-calibration",
      "description": "Confidence scores present and justified by sources",
      "weight": 0.2,
      "scale_min": 0,
      "scale_max": 1
    },
    {
      "id": "no-invention",
      "description": "No invented business capabilities or rule changes",
      "weight": 0.2,
      "scale_min": 0,
      "scale_max": 1
    }
  ],
  "veto_conditions": [
    {
      "id": "invent-business-logic",
      "description": "Output invents business capabilities or changes business rules"
    },
    {
      "id": "overwrite-discovery",
      "description": "Output overwrites discovery or Product RE artifacts"
    }
  ],
  "outputs": [
    "review-report"
  ],
  "status": "reserved",
  "extensions": {
    "pipeline": "solution-architecture"
  }
}
