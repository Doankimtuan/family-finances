{
  "schema_version": "1.0.0",
  "id": "execution-planner",
  "version": "0.1.0",
  "title": "Execution Planner",
  "description": "Before execution, generate execution graph, worker order, estimated outputs/runtime, artifacts/validation/review/checkpoint plans. Never execute immediately.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Runtime goal"
    },
    {
      "name": "workers",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/workers/"
    },
    {
      "name": "validators",
      "artifact_type": "doc-source",
      "required": false,
      "description": "core/packages/validators/"
    },
    {
      "name": "reviewers",
      "artifact_type": "doc-source",
      "required": false,
      "description": "core/packages/reviewers/"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/pipelines/"
    },
    {
      "name": "workflow",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/workflow/"
    },
    {
      "name": "templates",
      "artifact_type": "doc-source",
      "required": false,
      "description": "core/packages/templates/"
    },
    {
      "name": "schemas",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/schemas/"
    },
    {
      "name": "configs",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/configs/"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/"
    },
    {
      "name": "knowledge",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/knowledge/"
    },
    {
      "name": "registry",
      "artifact_type": "doc-source",
      "required": false,
      "description": "core/packages/registry/"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "runtime-plan",
      "primary": true,
      "description": "runtime-plan"
    }
  ],
  "requires_skills": [
    "command-interpreter",
    "dependency-resolver"
  ],
  "validators": [
    "runtime-engine-schema-check"
  ],
  "reviewers": [
    "runtime-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "draft",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "runtime-engine",
    "mutate_workers": false,
    "mutate_validators": false,
    "mutate_reviewers": false,
    "execute_workers": false,
    "orchestrate_only": true,
    "partition": "runtime/execution/execution-planner/",
    "raci": "core/packages/pipelines/runtime-engine/RACI.md",
    "gate_output_type": "gate-runtime-report",
    "entry_kinds": [
      "execution-graph",
      "worker-order",
      "estimated-outputs",
      "estimated-runtime",
      "validation-plan",
      "review-plan",
      "checkpoint-plan"
    ]
  }
}
