{
  "schema_version": "1.0.0",
  "id": "specification-reviewer",
  "version": "0.1.1",
  "title": "Specification Reviewer",
  "description": "Review specifications, requirements, acceptance criteria, API/database/UI/deployment specs, coding standards, and testing strategy. Never modify artifacts.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Review engine goal"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/ soft"
    },
    {
      "name": "validation",
      "artifact_type": "validation-finding",
      "required": true,
      "description": "artifacts/validation/"
    },
    {
      "name": "reports",
      "artifact_type": "validation-report",
      "required": true,
      "description": "artifacts/reports/ (assume validation PASS)"
    },
    {
      "name": "scores",
      "artifact_type": "quality-scores",
      "required": true,
      "description": "artifacts/scores/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "artifacts/knowledge/ soft"
    },
    {
      "name": "specifications",
      "artifact_type": "project-specification",
      "required": false,
      "description": "artifacts/specifications/ soft"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/pipelines/ (alias pipeline/)"
    },
    {
      "name": "requirements",
      "artifact_type": "requirement-spec",
      "required": false,
      "description": "artifacts/requirements/ soft"
    },
    {
      "name": "acceptance",
      "artifact_type": "acceptance-criteria",
      "required": false,
      "description": "artifacts/acceptance/ soft"
    },
    {
      "name": "architecture-v2",
      "artifact_type": "architecture-v2-spec",
      "required": false,
      "description": "artifacts/architecture-v2/ soft"
    },
    {
      "name": "tech-stack",
      "artifact_type": "tech-stack-recommendation",
      "required": false,
      "description": "artifacts/tech-stack/ soft"
    },
    {
      "name": "migration",
      "artifact_type": "migration-plan",
      "required": false,
      "description": "artifacts/migration/ soft"
    },
    {
      "name": "folder-structure",
      "artifact_type": "folder-structure-spec",
      "required": false,
      "description": "artifacts/folder-structure/ soft"
    },
    {
      "name": "features",
      "artifact_type": "feature-inventory",
      "required": false,
      "description": "artifacts/features/ soft"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "review-finding",
      "primary": true,
      "description": "review-finding"
    }
  ],
  "requires_skills": [],
  "validators": [
    "review-engine-schema-check"
  ],
  "reviewers": [
    "review-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "reserved",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "review-engine",
    "mutate_source_artifacts": false,
    "regenerate_outputs": false,
    "validate_schemas": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "raci": "core/packages/pipelines/review-engine/RACI.md",
    "gate_output_type": "gate-review-report",
    "partition": "governance/reviews/specification-reviewer/"
  }
}
