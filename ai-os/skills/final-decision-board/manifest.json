{
  "schema_version": "1.0.0",
  "id": "final-decision-board",
  "version": "0.1.1",
  "title": "Final Decision Board",
  "description": "Collect merged reviews; emit overall recommendation, critical risks, improvement plan, go/no-go, and release recommendation. Never modify artifacts.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Review engine goal"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/ soft"
    },
    {
      "name": "validation",
      "artifact_type": "validation-finding",
      "required": true,
      "description": "artifacts/validation/"
    },
    {
      "name": "reports",
      "artifact_type": "validation-report",
      "required": true,
      "description": "artifacts/reports/ (assume validation PASS)"
    },
    {
      "name": "scores",
      "artifact_type": "quality-scores",
      "required": true,
      "description": "artifacts/scores/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "artifacts/knowledge/ soft"
    },
    {
      "name": "specifications",
      "artifact_type": "project-specification",
      "required": false,
      "description": "artifacts/specifications/ soft"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/pipelines/ (alias pipeline/)"
    },
    {
      "name": "reviews",
      "artifact_type": "review-finding",
      "required": true,
      "description": "governance/reviews/ partitioned"
    },
    {
      "name": "governance",
      "artifact_type": "governance-decision",
      "required": false,
      "description": "governance/ soft"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "governance-decision",
      "primary": true,
      "description": "governance-decision partitioned"
    }
  ],
  "requires_skills": [],
  "validators": [
    "review-engine-schema-check"
  ],
  "reviewers": [
    "review-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "reserved",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "review-engine",
    "mutate_source_artifacts": false,
    "regenerate_outputs": false,
    "validate_schemas": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "raci": "core/packages/pipelines/review-engine/RACI.md",
    "gate_output_type": "gate-review-report"
  }
}
