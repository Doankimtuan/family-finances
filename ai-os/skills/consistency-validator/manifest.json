{
  "schema_version": "1.0.0",
  "id": "consistency-validator",
  "version": "0.1.1",
  "title": "Consistency Validator",
  "description": "Detect contradictions, duplications, conflicting artifacts/requirements/architecture/business rules, naming inconsistencies. Never modify artifacts.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Validation engine goal"
    },
    {
      "name": "schemas",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/schemas/"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/ soft"
    },
    {
      "name": "workers",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/workers/"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/pipelines/"
    },
    {
      "name": "execution",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/execution/ soft"
    },
    {
      "name": "templates",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/templates/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "artifacts/knowledge/ soft"
    },
    {
      "name": "registry",
      "artifact_type": "doc-source",
      "required": true,
      "description": "core/packages/registry/"
    },
    {
      "name": "features",
      "artifact_type": "feature-inventory",
      "required": false,
      "description": "artifacts/features/ soft"
    },
    {
      "name": "business",
      "artifact_type": "business-rules",
      "required": false,
      "description": "artifacts/business/ soft"
    },
    {
      "name": "requirements",
      "artifact_type": "requirement-spec",
      "required": false,
      "description": "artifacts/requirements/ soft"
    },
    {
      "name": "acceptance",
      "artifact_type": "acceptance-criteria",
      "required": false,
      "description": "artifacts/acceptance/ soft"
    },
    {
      "name": "product-architecture",
      "artifact_type": "product-architecture-notes",
      "required": false,
      "description": "artifacts/product-architecture/ soft"
    },
    {
      "name": "architecture-v2",
      "artifact_type": "architecture-v2-spec",
      "required": false,
      "description": "artifacts/architecture-v2/ soft"
    },
    {
      "name": "specifications",
      "artifact_type": "project-specification",
      "required": false,
      "description": "artifacts/specifications/ soft"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "validation-finding",
      "primary": true,
      "description": "validation-finding"
    }
  ],
  "requires_skills": [],
  "validators": [
    "validation-engine-schema-check"
  ],
  "reviewers": [
    "validation-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "reserved",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "validation-engine",
    "mutate_source_artifacts": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "partition": "artifacts/validation/consistency-validator/",
    "raci": "core/packages/pipelines/validation-engine/RACI.md",
    "gate_output_type": "gate-validation-report"
  }
