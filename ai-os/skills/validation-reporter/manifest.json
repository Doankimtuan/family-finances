{
  "schema_version": "1.0.0",
  "id": "validation-reporter",
  "version": "0.1.1",
  "title": "Validation Reporter",
  "description": "Emit severity-ranked validation-report with summary + PASS/FAIL decision. Machine-readable only. Never modify artifacts.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Validation engine goal"
    },
    {
      "name": "schemas",
      "artifact_type": "doc-source",
      "required": true,
      "description": "schemas/"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/ soft"
    },
    {
      "name": "workers",
      "artifact_type": "doc-source",
      "required": true,
      "description": "workers/"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "pipelines/"
    },
    {
      "name": "execution",
      "artifact_type": "doc-source",
      "required": false,
      "description": "execution/ soft"
    },
    {
      "name": "templates",
      "artifact_type": "doc-source",
      "required": true,
      "description": "templates/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "knowledge/ soft"
    },
    {
      "name": "validation",
      "artifact_type": "validation-finding",
      "required": true,
      "description": "validation/<worker_id>/ partitioned findings"
    },
    {
      "name": "scores",
      "artifact_type": "quality-scores",
      "required": true,
      "description": "scores/"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "validation-report",
      "primary": true,
      "description": "validation-report"
    }
  ],
  "requires_skills": [],
  "validators": [
    "validation-engine-schema-check"
  ],
  "reviewers": [
    "validation-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "reserved",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "validation-engine",
    "mutate_source_artifacts": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "raci": "pipelines/validation-engine/RACI.md",
    "gate_output_type": "gate-validation-report"
  }
}
