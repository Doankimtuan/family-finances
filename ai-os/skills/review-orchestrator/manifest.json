{
  "schema_version": "1.0.0",
  "id": "review-orchestrator",
  "version": "0.1.1",
  "title": "Review Orchestrator",
  "description": "Coordinate reviewers, merge partitioned findings, dedupe, emit review-status and ten-dimension review-scores. Never modify artifacts.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "Review engine goal"
    },
    {
      "name": "artifacts",
      "artifact_type": "doc-source",
      "required": false,
      "description": "artifacts/ soft"
    },
    {
      "name": "validation",
      "artifact_type": "validation-finding",
      "required": true,
      "description": "validation/"
    },
    {
      "name": "reports",
      "artifact_type": "validation-report",
      "required": true,
      "description": "reports/ (assume validation PASS)"
    },
    {
      "name": "scores",
      "artifact_type": "quality-scores",
      "required": true,
      "description": "scores/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "knowledge/ soft"
    },
    {
      "name": "specifications",
      "artifact_type": "project-specification",
      "required": false,
      "description": "specifications/ soft"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "pipelines/ (alias pipeline/)"
    },
    {
      "name": "reviews",
      "artifact_type": "review-finding",
      "required": true,
      "description": "reviews/ partitioned"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "review-status",
      "primary": true,
      "description": "review-status"
    },
    {
      "name": "scores",
      "artifact_type": "review-scores",
      "primary": false,
      "description": "review-scores under governance/"
    }
  ],
  "requires_skills": [],
  "validators": [
    "review-engine-schema-check"
  ],
  "reviewers": [
    "review-engine-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "reserved",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "review-engine",
    "mutate_source_artifacts": false,
    "regenerate_outputs": false,
    "validate_schemas": false,
    "invent_missing_information": false,
    "incremental": true,
    "partial": true,
    "raci": "pipelines/review-engine/RACI.md",
    "gate_output_type": "gate-review-report"
  }
}
