{
  "schema_version": "1.0.0",
  "id": "generation-reporter",
  "version": "0.1.1",
  "title": "Generation Reporter",
  "description": "Emit human-readable framework-generation-report and gate-framework-generation-report envelope from merged status.",
  "role": "executor",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "goal"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "framework-generation-report",
      "primary": true,
      "description": "framework-generation-report"
    }
  ],
  "requires_skills": [
    "generation-orchestrator"
  ],
  "validators": [
    "framework-generator-schema-check"
  ],
  "reviewers": [
    "framework-generator-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "draft",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "framework-generator",
    "partition": "core/packages/scaffold/reports/generation-reporter/",
    "entry_kinds": [
      "summary",
      "critical-gaps",
      "overall-recommendation",
      "gate-envelope"
    ],
    "gate_output_type": "gate-framework-generation-report"
  }
}
