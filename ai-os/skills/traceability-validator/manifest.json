    {
      "name": "workers",
      "artifact_type": "doc-source",
      "required": true,
      "description": "workers/"
    },
    {
      "name": "pipelines",
      "artifact_type": "doc-source",
      "required": true,
      "description": "pipelines/"
    },
    {
      "name": "execution",
      "artifact_type": "doc-source",
      "required": false,
      "description": "execution/ soft"
    },
    {
      "name": "templates",
      "artifact_type": "doc-source",
      "required": true,
      "description": "templates/"
    },
    {
      "name": "knowledge",
      "artifact_type": "knowledge-notes",
      "required": false,
      "description": "knowledge/ soft"
    },
    {
