{
  "schema_version": "1.0.0",
  "id": "generation-orchestrator",
  "version": "0.1.1",
  "title": "Generation Orchestrator",
  "description": "Record wave order, merge partitioned scaffold plans, dedupe by generation_id+entry_kind, emit framework-generation-status.",
  "role": "orchestrator",
  "grade": "guided",
  "inputs": [
    {
      "name": "goal",
      "artifact_type": "goal",
      "required": true,
      "description": "goal"
    }
  ],
  "outputs": [
    {
      "name": "primary",
      "artifact_type": "framework-generation-status",
      "primary": true,
      "description": "framework-generation-status"
    }
  ],
  "requires_skills": [
    "schema-generator",
    "artifact-generator",
    "prompt-generator",
    "worker-generator",
    "validator-generator",
    "reviewer-generator",
    "pipeline-generator",
    "test-generator",
    "documentation-generator",
    "project-bootstrap-generator"
  ],
  "validators": [
    "framework-generator-schema-check"
  ],
  "reviewers": [
    "framework-generator-coverage-review"
  ],
  "side_effects": [
    "runtime-write"
  ],
  "status": "draft",
  "entrypoint": "SKILL.md",
  "extensions": {
    "pipeline": "framework-generator",
    "partition": "core/packages/scaffold/status/generation-orchestrator/",
    "entry_kinds": [
      "plan",
      "order",
      "merge",
      "dedupe",
      "overall-status"
    ],
    "gate_output_type": "gate-framework-generation-report"
  }
}
