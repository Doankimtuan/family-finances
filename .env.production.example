# Public browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Generate with node node_modules/web-push/src/cli.js generate-vapid-keys.
# Put the VAPID public key here and its private key in the server-only setting below.
NEXT_PUBLIC_DAILY_EXPENSE_REMINDER_VAPID_PUBLIC_KEY=

# Server-only production configuration. Never use these as NEXT_PUBLIC_* values.
# Prefer the modern Supabase secret key.
SUPABASE_SECRET_KEY=
# Legacy fallback:
SUPABASE_SERVICE_ROLE_KEY=
MARKET_CATALOG_SYNC_SECRET=
MARKET_PRICE_SYNC_SECRET=
DAILY_EXPENSE_REMINDER_VAPID_PRIVATE_KEY=
DAILY_EXPENSE_REMINDER_VAPID_SUBJECT=
DAILY_EXPENSE_REMINDER_CRON_SECRET=
